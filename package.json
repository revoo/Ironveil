{
  "name": "ironveil",
  "version": "1.2.0-solo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev:client",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && node --import tsx tools/build-offline.ts",
    "test": "vitest run",
    "validate:map": "node --import tsx tools/validate-map.ts",
    "test:browser": "playwright test",
    "dev:all": "concurrently -k -n server,client 'npm:dev:server' 'npm:dev:client'",
    "diagnostics:solo": "node --import tsx tools/solo-diagnostics.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "serve:solo": "node tools/serve-solo.mjs",
    "package:solo": "npm run build && node tools/package-solo.mjs",
    "soak:solo": "node --import tsx tools/soak-solo.ts",
    "diagnostics:ai": "node --import tsx tools/ai-diagnostics.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.16.24",
    "@colyseus/ws-transport": "0.16.5",
    "colyseus.js": "0.16.22",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "20.17.30",
    "concurrently": "9.1.2",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  }
}
